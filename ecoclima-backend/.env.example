PORT=3000

# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Cloud API configuration
WHATSAPP_TOKEN=your_whatsapp_temporary_or_permanent_token_here
WHATSAPP_VERIFY_TOKEN=any_secure_random_string_you_define
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Firebase Admin configuration (GCP Firestore)
FIREBASE_PROJECT_ID=your_gcp_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
# Note: Private key should replace actual \n with literal newlines if loaded directly, or handled programmatically
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Maps API configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
