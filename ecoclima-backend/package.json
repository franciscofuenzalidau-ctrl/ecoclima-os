{
  "name": "ecoclima-backend",
  "version": "1.0.0",
  "description": "Backend for ECOCLIMA OS chatbot integrating WhatsApp, Gemini API, Firestore, and Google Maps",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test:chat": "ts-node-dev --respawn --transpile-only src/test-local.ts",
    "test:once": "ts-node-dev --respawn --transpile-only src/test-once.ts"
  },
  "keywords": [
    "whatsapp",
    "gemini",
    "firestore",
    "hvac"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.7.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase-admin": "^12.7.0",
    "nodemailer": "^8.0.10",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
